@{
    ViewData["Title"] = "System Settings";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["ActivePage"] = "SystemSettings";
}

<div class="dashboard-shell">
    @await Html.PartialAsync("_DashboardSidebar")
    <main class="main-content" style="padding: 20px;">

<div class="content-header mb-4">
    <h2>System Settings</h2>
    <p class="text-muted">Configure hardware, gateway, and database maintenance</p>
</div>

<div class="row">
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white">
                <h5 class="mb-0">SMS Gateway Configuration (GSM Modem)</h5>
            </div>
            <div class="card-body">
                <form>
                    <div class="mb-3">
                        <label class="form-label">COM Port</label>
                        <select class="form-select">
                            <option>COM1</option>
                            <option>COM2</option>
                            <option selected>COM3</option>
                            <option>COM4</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">Baud Rate</label>
                        <select class="form-select">
                            <option>9600</option>
                            <option selected>115200</option>
                        </select>
                    </div>
                    <div class="mb-3">
                        <label class="form-label">API Key (If using 3rd Party Gateway)</label>
                        <input type="password" class="form-control" value="xxxxxxxxxxxxxxxxxxxx" />
                    </div>
                    <button type="button" class="btn btn-primary px-4">Save Configuration</button>
                    <button type="button" class="btn btn-outline-secondary ms-2">Test Connection</button>
                </form>
            </div>
        </div>
    </div>
    
    <div class="col-md-6">
        <div class="card shadow-sm mb-4">
            <div class="card-header bg-white text-danger">
                <h5 class="mb-0">Database Maintenance</h5>
            </div>
            <div class="card-body">
                <p class="text-muted">Use these tools carefully. Creating a backup before running maintenance is highly recommended.</p>
                <div class="d-grid gap-3">
                    <button type="button" class="btn btn-outline-success">Generate Database Backup</button>
                    <button type="button" class="btn btn-outline-warning">Clear Old SMS Logs (> 1 Year)</button>
                    <button type="button" class="btn btn-outline-danger">Factory Reset All Settings</button>
                </div>
            </div>
        </div>
    </div>
</div>

    </main>
</div>
