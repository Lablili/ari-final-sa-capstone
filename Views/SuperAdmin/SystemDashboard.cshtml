@{
    ViewData["Title"] = "System Dashboard";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["ActivePage"] = "SystemDashboard";
}

<div class="dashboard-shell">
    @await Html.PartialAsync("_DashboardSidebar")
    <main class="main-content" style="padding: 20px;">

<header class="topbar">
    <div class="topbar-title-area">
        <h2>Super Admin System Dashboard</h2>
        <p class="text-muted" style="margin-top: 4px; font-size: 0.9rem;">High-level overview of all system modules</p>
    </div>
    <div class="topbar-meta">
        <span class="date-indicator">
            <svg class="date-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 2v4M8 2v4M3 10h18"></path>
            </svg>
            <span id="currentDateDisplay">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
        </span>
    </div>
</header>

<section class="stats-grid" style="margin-top: 24px;">
    <article class="stat-card">
        <p class="stat-title">Registered Fisherfolk</p>
        <h3 style="color: var(--accent);">@ViewBag.TotalFisherfolk</h3>
        <p class="stat-subtext positive">Total active profiles</p>
    </article>
    
    <article class="stat-card">
        <p class="stat-title">Total Blotter Reports</p>
        <h3 style="color: #ef4444;">@ViewBag.TotalBlotters</h3>
        <p class="stat-subtext text-muted">Documented cases</p>
    </article>
    
    <article class="stat-card">
        <p class="stat-title">Total SMS Handled</p>
        <h3 style="color: #10b981;">@ViewBag.TotalSmsLogs</h3>
        <p class="stat-subtext text-muted">Sent & received logs</p>
    </article>
    
    <article class="stat-card">
        <p class="stat-title">Community Reports</p>
        <h3 style="color: #f59e0b;">@ViewBag.TotalCommunityReports</h3>
        <p class="stat-subtext text-muted">Submitted via feedback</p>
    </article>
</section>

<section class="panel" style="margin-top: 24px;">
    <div class="panel-header">
        <h3>System Activity Stream</h3>
    </div>
    <div class="database-container" style="text-align: center; padding: 60px 20px;">
        <span style="font-size: 3rem; color: #ddd; display: block; margin-bottom: 12px;">📈</span>
        <h4 style="color: var(--text);">All systems operational</h4>
        <p style="color: var(--text-muted); font-size: 0.95rem;">System is running smoothly and data is syncing in real-time.</p>
    </div>
</section>

    </main>
</div>
