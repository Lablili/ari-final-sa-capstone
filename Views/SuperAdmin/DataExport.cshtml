@{
    ViewData["Title"] = "Data Export & Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["ActivePage"] = "DataExport";
}

<div class="dashboard-shell">
    @await Html.PartialAsync("_DashboardSidebar")
    <main class="main-content" style="padding: 20px;">

<header class="topbar">
    <div class="topbar-title-area">
        <h2>Data Export Center</h2>
        <p class="text-muted" style="margin-top: 4px; font-size: 0.9rem;">Generate comprehensive CSV reports across all system modules</p>
    </div>
    <div class="topbar-meta">
        <span class="date-indicator">
            <svg class="date-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                <path stroke-linecap="round" stroke-linejoin="round" d="M16 2v4M8 2v4M3 10h18"></path>
            </svg>
            <span>@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
        </span>
    </div>
</header>

<div class="content-grid" style="grid-template-columns: 1fr 1fr; gap: 24px; margin-top: 24px;">
    <!-- Fisherfolk Registry -->
    <section class="panel text-center" style="padding: 40px 20px;">
        <span style="font-size: 3rem; display: block; margin-bottom: 16px;">👥</span>
        <h3 style="color: var(--text);">Fisherfolk Registry</h3>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 8px; margin-bottom: 24px;">Export complete details of all registered fisherfolk, including vessel info and permits.</p>
        <a asp-controller="Home" asp-action="ExportFisherfolkCsv" class="btn-primary" style="display: inline-block; text-decoration: none;">Download CSV File</a>
    </section>

    <!-- Blotter Reports -->
    <section class="panel text-center" style="padding: 40px 20px;">
        <span style="font-size: 3rem; display: block; margin-bottom: 16px;">📋</span>
        <h3 style="color: var(--text);">Blotter Reports</h3>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 8px; margin-bottom: 24px;">Export all recorded incidents, illegal fishing encounters, and response times.</p>
        <a asp-controller="SuperAdmin" asp-action="ExportBlottersCsv" class="btn-primary" style="background-color: #ef4444; display: inline-block; text-decoration: none;">Download CSV File</a>
    </section>

    <!-- SMS Logs -->
    <section class="panel text-center" style="padding: 40px 20px;">
        <span style="font-size: 3rem; display: block; margin-bottom: 16px;">✉️</span>
        <h3 style="color: var(--text);">SMS Delivery Logs</h3>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 8px; margin-bottom: 24px;">Export the raw SMS log table containing timestamps, numbers, and delivery statuses.</p>
        <a asp-controller="SuperAdmin" asp-action="ExportSmsLogsCsv" class="btn-outline" style="display: inline-block; text-decoration: none;">Download CSV File</a>
    </section>

    <!-- Community Reports -->
    <section class="panel text-center" style="padding: 40px 20px;">
        <span style="font-size: 3rem; display: block; margin-bottom: 16px;">📢</span>
        <h3 style="color: var(--text);">Community Reports / SOS</h3>
        <p style="color: var(--text-muted); font-size: 0.95rem; margin-top: 8px; margin-bottom: 24px;">Export all raw SOS texts and feedback reports received from the fisherfolk.</p>
        <a asp-controller="Home" asp-action="ExportFeedbackCsv" class="btn-primary" style="background-color: #10b981; display: inline-block; text-decoration: none;">Download CSV File</a>
    </section>
</div>

    </main>
</div>
