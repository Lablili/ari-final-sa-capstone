@{
    ViewData["Title"] = "Feedback";
}


<div class="dashboard-shell hidden" id="dashboardShell">
    @await Html.PartialAsync("_DashboardSidebar")

    <main class="main-content">
        <header class="topbar">
            <div class="topbar-title-area">
                <h2>Feedback</h2>
            </div>
            <div class="topbar-meta">
                <span class="stat-badge" id="newBadge">0 Bag-o</span>
                <span class="date-indicator">
                    <svg class="date-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 2v4M8 2v4M3 10h18"></path>
                    </svg>
                    <span id="currentDateDisplay">Wednesday, May 27, 2026</span>
                </span>

            </div>
        </header>

        <div class="stat-row">
            <div class="stat"><div><div class="stat-n" id="s-total">0</div><div class="stat-l">Total</div></div></div>
            <div class="stat"><div><div class="stat-n" id="s-sos">0</div><div class="stat-l">SOS / Rescue</div></div></div>
            <div class="stat"><div><div class="stat-n" id="s-inc">0</div><div class="stat-l">Incident</div></div></div>
            <div class="stat"><div><div class="stat-n" id="s-new">0</div><div class="stat-l">Others</div></div></div>
        </div>

        <div class="filters-search-panel">
            <div class="barangay-filters" id="chips">
                <button class="filter-button active" data-f="all" type="button">All <span class="chip-count" id="cc-all">0</span></button>
                <button class="filter-button" data-f="sos" type="button">
                    <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="8" x2="12" y2="12"/><line x1="12" y1="16" x2="12.01" y2="16"/></svg>
                    SOS / Rescue <span class="chip-count" id="cc-sos">0</span>
                </button>
                <button class="filter-button" data-f="incident" type="button">
                    <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M10.29 3.86L1.82 18a2 2 0 0 0 1.71 3h16.94a2 2 0 0 0 1.71-3L13.71 3.86a2 2 0 0 0-3.42 0z"/><line x1="12" y1="9" x2="12" y2="13"/><line x1="12" y1="17" x2="12.01" y2="17"/></svg>
                    Incident <span class="chip-count" id="cc-incident">0</span>
                </button>
                <button class="filter-button" data-f="complaint" type="button">
                    <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"/></svg>
                    Complaint <span class="chip-count" id="cc-complaint">0</span>
                </button>
                <button class="filter-button" data-f="info" type="button">
                    <svg width="11" height="11" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24"><circle cx="12" cy="12" r="10"/><line x1="12" y1="16" x2="12" y2="12"/><line x1="12" y1="8" x2="12.01" y2="8"/></svg>
                    Other <span class="chip-count" id="cc-info">0</span>
                </button>
            </div>
            <div class="search-wrapper">
                <svg class="search-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                    <circle cx="11" cy="11" r="8"></circle><line x1="21" y1="21" x2="16.65" y2="16.65"></line>
                </svg>
                <input class="search-input" id="searchInput" type="text" placeholder="Search Message">
                <button class="btn-outline" id="btnClear" style="display:none; margin-left: 8px;" onclick="clearFilters()">Clear</button>
            </div>
        </div>

        <div class="database-container">
            <div class="table-header-meta" style="padding: 14px 20px; border-bottom: 1px solid var(--border-light); font-size: 13px; font-weight: 600; color: var(--text-muted); display: flex; justify-content: space-between;">
                <span id="recCount">0 record</span>
            </div>
            <table class="fisherfolk-table">
                <thead>
                    <tr>
                        <th style="width:120px">Category</th>
                        <th>Sender</th>
                        <th style="width:280px">Subject</th>
                        <th style="width:90px">Content</th>
                        <th style="width:120px">Date Sent</th>
                        <th style="width:72px"></th>
                    </tr>
                </thead>
                <tbody id="tbody"></tbody>
            </table>
            <div class="empty-state" id="emptyState" style="display:none">
                <svg width="32" height="32" fill="none" stroke="currentColor" stroke-width="1.5" viewBox="0 0 24 24"><path d="M21 15a2 2 0 0 1-2 2H7l-4 4V5a2 2 0 0 1 2-2h14a2 2 0 0 1 2 2z"></path></svg>
                <p>No messages found for your selection.</p>
            </div>
            <div class="pagination">
                <span id="pgInfo">—</span>
                <div class="pg-btns">
                    <button class="pg-btn" id="btnPrev" onclick="goPage(-1)">&#8592; previous</button>
                    <span id="pgNum" style="font-size:.75rem;font-weight:600;color:#0f172a;padding:0 6px"></span>
                    <button class="pg-btn" id="btnNext" onclick="goPage(1)">next &#8594;</button>
                </div>
            </div>
        </div>

        <div class="modal hidden" id="detailModal">
            <div class="modal-overlay" id="detailModalOverlay"></div>
            <div class="modal-content">
                <div class="modal-header">
                    <h2>Detalye sa Mensahe</h2>
                    <button class="modal-close" id="detailModalCloseButton" type="button" aria-label="Close">&times;</button>
                </div>
                <div class="modal-body" id="detailBody"></div>
            </div>
        </div>

        <div class="overlay" id="blotterOverlay">
            <div class="blotter-modal-card">
                <div class="modal-head">
                    <h3>Blotter Form</h3>
                    <button class="btn-close" onclick="closeBlotter()">&#10005;</button>
                </div>
                <div class="blotter" id="blotterBody"></div>
                <div class="modal-foot">
                    <button class="btn-secondary" onclick="closeBlotter()">Cancel</button>
                    <button class="btn-primary" onclick="window.print()">Print Blotter</button>
                </div>
            </div>
        </div>
    </main>
</div>

@section Scripts {
    <script src="~/js/Feedback.js" asp-append-version="true"></script>
}
