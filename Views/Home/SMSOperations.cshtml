@{
    ViewData["Title"] = "SMS Operations";
    var userRole = Context.Session.GetString("UserRole") ?? "";
}

<div class="dashboard-shell" id="dashboardShell" style="height: 100vh; overflow: hidden; display: flex;">
    @await Html.PartialAsync("_DashboardSidebar")

    <main class="main-content">
        <header class="topbar">
            <div class="topbar-title-area">
                <h2>SMS Operations</h2>
            </div>
            <div class="topbar-meta">
                <span class="stat-badge" style="background:#f1f5f9; color:#475569; border: 1px solid #cbd5e1;">System Healthy</span>
                <span class="date-indicator">
                    <svg class="date-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 2v4M8 2v4M3 10h18"></path>
                    </svg>
                    <span id="currentDateDisplay">@DateTime.Now.ToString("dddd, MMMM dd, yyyy")</span>
                </span>
            </div>
        </header>

        <div style="display: grid; grid-template-columns: repeat(auto-fit, minmax(300px, 1fr)); gap: 20px; margin-bottom: 24px;">
            
            <!-- SMS Activity -->
            <div class="panel" style="padding: 20px; border-top: 4px solid #cbd5e1;">
                <div class="panel-header" style="margin-bottom:15px; border:none; padding:0;">
                    <h3 style="margin:0; display:flex; align-items:center; gap:8px;">
                        <svg width="20" height="20" fill="none" stroke="#64748b" stroke-width="2" viewBox="0 0 24 24"><path d="M22 2L11 13M22 2l-7 20-4-9-9-4 20-7z"/></svg>
                        Today's SMS Activity
                    </h3>
                </div>
                <ul style="list-style:none; padding:0; margin:0; color:#475569; line-height: 1.8;">
                    <li style="display:flex; justify-content:space-between;"><span>SMS Sent Today:</span> <strong style="color:#0f172a;" id="sms-sent-today">@ViewBag.SmsSentToday</strong></li>
                    <li style="display:flex; justify-content:space-between;"><span>SMS Received Today:</span> <strong style="color:#0f172a;">0</strong></li>
                    <li style="display:flex; justify-content:space-between;"><span>Delivery Success Rate:</span> <strong style="color:#0f172a;">@ViewBag.SuccessRate</strong></li>
                    <li style="display:flex; justify-content:space-between;"><span>Failed Messages:</span> <strong style="color:#0f172a;" id="sms-failed-today">@ViewBag.SmsFailedToday</strong></li>
                    <li style="display:flex; justify-content:space-between;"><span>Avg Delivery Time:</span> <strong style="color:#0f172a;">~2-7 seconds</strong></li>
                </ul>
            </div>

            <!-- SMS Credits -->
            <div class="panel" style="padding: 20px; border-top: 4px solid #cbd5e1;">
                <div class="panel-header" style="margin-bottom:15px; border:none; padding:0;">
                    <h3 style="margin:0; display:flex; align-items:center; gap:8px;">
                        <svg width="20" height="20" fill="none" stroke="#64748b" stroke-width="2" viewBox="0 0 24 24"><rect x="2" y="5" width="20" height="14" rx="2" ry="2"/><line x1="2" y1="10" x2="22" y2="10"/></svg>
                        SMS Credits
                    </h3>
                </div>
                <ul style="list-style:none; padding:0; margin:0; color:#475569; line-height: 1.8;">
                    <li style="display:flex; justify-content:space-between;"><span>Current Balance:</span> <strong style="color:#0f172a;">Unlimited</strong></li>
                    <li style="display:flex; justify-content:space-between;"><span>Used This Month:</span> <strong style="color:#0f172a;">-</strong></li>
                    <li style="display:flex; justify-content:space-between;"><span>Remaining Budget:</span> <strong style="color:#0f172a;">-</strong></li>
                </ul>
                <div style="margin-top: 15px; padding: 8px 12px; background:#f8fafc; border:1px solid #e2e8f0; border-radius:6px; color:#475569; display:flex; align-items:center; gap:6px;">
                    <svg width="14" height="14" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24"><path d="M22 11.08V12a10 10 0 1 1-5.93-9.14"/><polyline points="22 4 12 14.01 9 11.01"/></svg>
                    <strong>Hardware Gateway Active</strong> 
                </div>
            </div>

            <!-- GSM Gateway Status -->
            <div class="panel" style="padding: 20px; display: flex; flex-direction: column; justify-content: center; border: 1px solid #e2e8f0; border-radius: 12px; box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.1);">
                <p style="color: #64748b; font-size: 1.1rem; margin-bottom: 8px;">GSM Gateway Status</p>
                @if (ViewBag.HardwareStatus == "Online")
                {
                    <h3 id="stat-gsm-status" style="color: #22c55e; font-size: 3.2rem; font-weight: 700; margin: 5px 0;">Online</h3>
                }
                else
                {
                    <h3 id="stat-gsm-status" style="color: #ef4444; font-size: 3.2rem; font-weight: 700; margin: 5px 0;">Offline</h3>
                }
                <p id="stat-gsm-sub" style="color: #64748b; font-size: 1rem; margin: 0;">@ViewBag.HardwareMessage</p>
            </div>
        </div>

        <!-- Recent SMS Log Section -->
        <div class="panel" style="padding: 20px;">
            <div class="panel-header" style="border-bottom:1px solid #e2e8f0; padding-bottom:15px; margin-bottom:15px;">
                <h3 style="margin:0; display:flex; align-items:center; gap:8px;">
                    <svg width="20" height="20" fill="none" stroke="#64748b" stroke-width="2" viewBox="0 0 24 24"><path d="M14 2H6a2 2 0 0 0-2 2v16a2 2 0 0 0 2 2h12a2 2 0 0 0 2-2V8z"/><polyline points="14 2 14 8 20 8"/><line x1="16" y1="13" x2="8" y2="13"/><line x1="16" y1="17" x2="8" y2="17"/><polyline points="10 9 9 9 8 9"/></svg>
                    Recent SMS Log
                </h3>
                <div style="display:flex; gap:10px;">
                    <div style="display:flex; gap:5px; align-items:center;">
                        <input type="date" class="filter-dropdown" style="padding:5px 10px; border:1px solid #cbd5e1; border-radius:6px;">
                        <span style="color:#64748b;">to</span>
                        <input type="date" class="filter-dropdown" style="padding:5px 10px; border:1px solid #cbd5e1; border-radius:6px;">
                    </div>
                    <button id="btnExportReport" class="btn-outline" style="padding:5px 12px;">Export Report</button>
                    <button id="btnRetryFailed" class="btn-primary" style="padding:5px 12px;">Retry Failed</button>
                </div>
            </div>

            <!-- Tabs -->
            <div style="display:flex; gap:15px; margin-bottom:15px; border-bottom:1px solid #f1f5f9; padding-bottom:10px;">
                <button id="btnSentMessages" style="background:none; border:none; padding:5px 10px; color:#0f172a; border-bottom:2px solid #0f172a; cursor:pointer;">View Sent Messages</button>
                <button id="btnReceivedMessages" style="background:none; border:none; padding:5px 10px; color:#64748b; border-bottom:2px solid transparent; cursor:pointer;">View Received Messages</button>
            </div>

            <!-- Table -->
            <table class="fisherfolk-table" style="width:100%;">
                <thead>
                    <tr>
                        <th>Status</th>
                        <th>Phone Number</th>
                        <th>Type</th>
                        <th style="width: 40%">Message Content</th>
                        <th>Time</th>
                    </tr>
                </thead>
                <tbody id="sms-log-tbody">
                </tbody>
            </table>
        </div>
    </main>
</div>

@section Scripts {
    <script>
        let currentTab = 'sent';

        async function loadSentMessages() {
            try {
                const response = await fetch('/api/SmsLogsApi/sent');
                const data = await response.json();
                renderTable(data, 'sent');
            } catch (e) {
                console.error('Error fetching sent messages:', e);
            }
        }

        async function loadReceivedMessages() {
            try {
                const response = await fetch('/api/SmsLogsApi/received');
                const data = await response.json();
                renderTable(data, 'received');
            } catch (e) {
                console.error('Error fetching received messages:', e);
            }
        }

        function renderTable(data, tabType) {
            const tbody = document.getElementById('sms-log-tbody');
            tbody.innerHTML = '';

            if (data.length === 0) {
                tbody.innerHTML = `<tr><td colspan="5" style="text-align:center; padding: 20px; color: #64748b;">No ${tabType} messages found.</td></tr>`;
                return;
            }

            data.forEach(msg => {
                let badgeStyle = '';
                let statusText = msg.status || (tabType === 'sent' ? 'PENDING' : 'RECEIVED');
                let rowClass = statusText.toUpperCase() === 'FAILED' ? 'class="failed-msg"' : '';
                let phoneClass = statusText.toUpperCase() === 'FAILED' ? 'class="failed-num"' : '';

                if (statusText.toUpperCase() === 'DELIVERED') {
                    badgeStyle = 'background:#f0fdf4; color:#16a34a; border:1px solid #86efac;';
                } else if (statusText.toUpperCase() === 'FAILED') {
                    badgeStyle = 'background:#fef2f2; color:#ef4444; border:1px solid #fca5a5;';
                } else if (statusText.toUpperCase() === 'PENDING') {
                    badgeStyle = 'background:#fefce8; color:#eab308; border:1px solid #fde047;';
                } else if (statusText.toUpperCase() === 'READ') {
                     badgeStyle = 'background:#f1f5f9; color:#475569; border:1px solid #cbd5e1;';
                } else if (statusText.toUpperCase() === 'UNREAD') {
                     badgeStyle = 'background:#eff6ff; color:#3b82f6; border:1px solid #bfdbfe;';
                } else {
                     badgeStyle = 'background:#f1f5f9; color:#475569; border:1px solid #cbd5e1;';
                }

                // Format date
                const dateObj = new Date(msg.timestampSent);
                const formattedDate = dateObj.toLocaleDateString() + ' ' + dateObj.toLocaleTimeString([], {hour: '2-digit', minute:'2-digit'});

                const tr = document.createElement('tr');
                if (rowClass) tr.className = 'failed-msg';
                
                tr.innerHTML = `
                    <td><span class="cat-badge" style="${badgeStyle}">${statusText}</span></td>
                    <td ${phoneClass}><strong>${msg.phoneNumber || 'N/A'}</strong></td>
                    <td><span style="color:#64748b;">${msg.messageType || 'Announcement'}</span></td>
                    <td style="color:#475569; max-width: 350px; white-space: nowrap; overflow: hidden; text-overflow: ellipsis;" title="${msg.messageContent ? msg.messageContent.replace(/"/g, '&quot;') : ''}">${msg.messageContent || ''}</td>
                    <td style="color:#64748b;">${formattedDate}</td>
                `;
                tbody.appendChild(tr);
            });
        }
        
        document.addEventListener('DOMContentLoaded', function() {
            // Initially load sent messages
            loadSentMessages();

            const btnSent = document.getElementById('btnSentMessages');
            const btnReceived = document.getElementById('btnReceivedMessages');
            const btnRetry = document.getElementById('btnRetryFailed');
            const btnExport = document.getElementById('btnExportReport');

            btnSent.addEventListener('click', function() {
                if (currentTab === 'sent') return;
                currentTab = 'sent';
                btnSent.style.color = '#0f172a';
                btnSent.style.borderBottom = '2px solid #0f172a';
                btnReceived.style.color = '#64748b';
                btnReceived.style.borderBottom = '2px solid transparent';
                document.getElementById('sms-log-tbody').innerHTML = '<tr><td colspan="5" style="text-align:center;">Loading...</td></tr>';
                loadSentMessages();
            });

            btnReceived.addEventListener('click', function() {
                if (currentTab === 'received') return;
                currentTab = 'received';
                btnReceived.style.color = '#0f172a';
                btnReceived.style.borderBottom = '2px solid #0f172a';
                btnSent.style.color = '#64748b';
                btnSent.style.borderBottom = '2px solid transparent';
                document.getElementById('sms-log-tbody').innerHTML = '<tr><td colspan="5" style="text-align:center;">Loading...</td></tr>';
                loadReceivedMessages();
            });

            btnRetry.addEventListener('click', function() {
                const failedRows = document.querySelectorAll('.failed-msg');
                if (failedRows.length === 0) {
                    alert("No failed messages to retry in the current view.");
                    return;
                }

                let failedNumbers = [];
                document.querySelectorAll('.failed-num strong').forEach(el => {
                    failedNumbers.push(el.textContent);
                });

                const confirmMsg = "Are you sure you want to retry sending " + failedNumbers.length + " failed message(s)?\n\nFailed numbers:\n" + failedNumbers.join(", ");
                if(confirm(confirmMsg)) {
                    alert("Retrying messages for: " + failedNumbers.join(", ") + "...");
                    // Placeholder: call API here
                }
            });

            btnExport.addEventListener('click', function() {
                const rows = document.querySelectorAll('#sms-log-tbody tr');
                if(rows.length === 0) {
                    alert('No data to export.');
                    return;
                }
                
                let csvContent = "data:text/csv;charset=utf-8,Status,Phone Number,Type,Message Content,Time\n";
                rows.forEach(function(row) {
                    let rowData = [];
                    row.querySelectorAll('td').forEach(function(el) {
                        let text = el.innerText.replace(/,/g, '').replace(/"/g, '');
                        rowData.push(text);
                    });
                    csvContent += rowData.join(",") + "\r\n";
                });
                
                const encodedUri = encodeURI(csvContent);
                const link = document.createElement("a");
                link.setAttribute("href", encodedUri);
                link.setAttribute("download", "sms_report.csv");
                document.body.appendChild(link);
                
                link.click();
                document.body.removeChild(link);
            });
        });
    </script>
}
