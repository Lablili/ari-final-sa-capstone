@{
    ViewData["Title"] = "Overview";
    var sessionRole = Context?.Session?.GetString("UserRole");
    var displayRole = !string.IsNullOrEmpty(sessionRole) ? sessionRole : (User != null && User.Identity.IsAuthenticated ? string.Join(", ", (User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))) : "");
    var isSuperAdmin = displayRole == "SuperAdmin";
}

<div class="dashboard-shell">
    @await Html.PartialAsync("_DashboardSidebar")

    <main class="main-content">
        <header class="topbar">
            <div class="topbar-title-area">
                <h2>Dashboard</h2>
            </div>
            <div class="topbar-meta">
                <span class="stat-badge" id="newBadge">0 New</span>
                <span class="date-indicator">
                    <svg class="date-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 2v4M8 2v4M3 10h18"></path>
                    </svg>
                    <span id="currentDateDisplay">Wednesday, May 27, 2026</span>
                </span>

            </div>
        </header>

        <section class="stats-grid">
            <article class="stat-card">
                <p class="stat-title">Registered Fisherfolk</p>
                <h3 id="stat-fisherfolk">0</h3>
                <p class="stat-subtext positive" id="stat-fisherfolk-sub">Active Registry</p>
            </article>
            <article class="stat-card">
                <p class="stat-title">Incident Reports</p>
                <h3 id="stat-reports">0</h3>
                <p class="stat-subtext negative" id="stat-reports-sub">0 New Reports</p>
            </article>
            <article class="stat-card">
                <p class="stat-title">Announcements Sent Today</p>
                <h3 id="stat-announcements">0</h3>
                <p class="stat-subtext" id="stat-announcements-sub">via GSM/SMS</p>
            </article>
        </section>

        @if (isSuperAdmin)
        {
            <section class="content-grid" style="grid-template-columns: 1fr 1fr; gap: 20px;">
                <article class="panel">
                    <div class="panel-header">
                        <h3>Fisherfolk Registry Breakdown</h3>
                    </div>
                    <div style="padding: 20px; height: 300px; display: flex; justify-content: center; align-items: center;">
                        <canvas id="fisherfolkChart"></canvas>
                    </div>
                </article>
                <article class="panel">
                    <div class="panel-header">
                        <h3>System Activity Overview</h3>
                    </div>
                    <div style="padding: 20px; height: 300px; display: flex; justify-content: center; align-items: center;">
                        <canvas id="activityChart"></canvas>
                    </div>
                </article>
            </section>
        }
        else
        {
        <section class="content-grid">
            <article class="panel">
                <div class="panel-header">
                    <h3>Recent incident reports</h3>
                    <a class="panel-link" asp-controller="Home" asp-action="Feedback">Open Incident File</a>
                </div>

                <div class="report-list">
                    <div class="list-item new-report">
                        <span class="list-dot red"></span>
                        <div>
                            <div class="report-heading">
                                <p class="item-title">Naa mi nadunggan nga kusog nga buto sa dagat duol sa Barangay Patao, basin naay naggamit og dinamita.</p>
                                <span class="report-badge">Bag-o</span>
                            </div>
                            <p class="item-meta">Gipadala ni 0917 842 3156 &middot; 2h ago</p>
                        </div>
                    </div>
                    <div class="list-item new-report">
                        <span class="list-dot amber"></span>
                        <div>
                            <div class="report-heading">
                                <p class="item-title">Nakita namo nga pino kaayo og mata ang pukot nga gigamit duol sa Barangay Kabac.</p>
                                <span class="report-badge">Bag-o</span>
                            </div>
                            <p class="item-meta">Gipadala ni 0928 554 1073 &middot; 5h ago</p>
                        </div>
                    </div>
                    <div class="list-item new-report">
                        <span class="list-dot red"></span>
                        <div>
                            <div class="report-heading">
                                <p class="item-title">Naay dakong sakayan nga nisulod sa municipal waters duol sa Barangay Sulangan bisan murag dili rehistrado diri.</p>
                                <span class="report-badge">Bag-o</span>
                            </div>
                            <p class="item-meta">Gipadala ni 0951 663 2480 &middot; 8h ago</p>
                        </div>
                    </div>
                    <div class="list-item">
                        <span class="list-dot blue"></span>
                        <div>
                            <div class="report-heading">
                                <p class="item-title">Naa pay nangisda sulod sa protected area sa Barangay Patao gabii.</p>
                            </div>
                            <p class="item-meta">Gipadala ni 0936 214 7895 &middot; 1d ago</p>
                        </div>
                    </div>
                </div>

                <a class="report-footer-link" asp-controller="Home" asp-action="Feedback">Tan-awa ang tanang reports sa Incident Reports file</a>
            </article>

            <article class="panel">
                <div class="panel-header plain">
                    <h3>Latest announcements</h3>
                    <a class="panel-link" asp-controller="Home" asp-action="Announcement">Open Announcement Center</a>
                </div>

                <div class="announcement-list">
                    <div class="list-item">
                        <span class="list-dot blue"></span>
                        <div>
                            <p class="item-title">No-fishing zone notice &mdash; Barangay Patao</p>
                            <p class="item-meta">GSM broadcast sent to all fisherfolk &middot; May 4</p>
                        </div>
                    </div>
                    <div class="list-item">
                        <span class="list-dot blue"></span>
                        <div>
                            <p class="item-title">Patrol advisory &mdash; northern coastal zone</p>
                            <p class="item-meta">GSM broadcast sent &middot; May 4</p>
                        </div>
                    </div>
                    <div class="list-item">
                        <span class="list-dot blue"></span>
                        <div>
                            <p class="item-title">Closed season reminder &mdash; municipal waters</p>
                            <p class="item-meta">Sent to licensed fishers &middot; May 3</p>
                        </div>
                    </div>
                    <div class="list-item">
                        <span class="list-dot green"></span>
                        <div>
                            <p class="item-title">Rescue hotline reminder &mdash; Bantayan municipality</p>
                            <p class="item-meta">Posted for registered fisherfolk &middot; May 2</p>
                        </div>
                    </div>
                </div>
                <button class="scroll-button" aria-label="Scroll for more">
                    <span></span>
                </button>
            </article>
        </section>
        }
    </main>
</div>

@section Scripts {
    <script src="~/js/overview-sync.js" asp-append-version="true"></script>
    @if (isSuperAdmin)
    {
        <script src="https://cdn.jsdelivr.net/npm/chart.js"></script>
        <script>
            document.addEventListener('DOMContentLoaded', function() {
                // Fisherfolk Chart (Pie)
                var rawF = localStorage.getItem('bantay-dagat-fisherfolk-database');
                var countF = 3;
                if (rawF) {
                    try { 
                        var dataF = JSON.parse(rawF);
                        countF = dataF.length;
                    } catch(e) {}
                }
                
                var ctxF = document.getElementById('fisherfolkChart').getContext('2d');
                new Chart(ctxF, {
                    type: 'pie',
                    data: {
                        labels: ['Active Fisherfolk', 'Pending Verification', 'Archived'],
                        datasets: [{
                            data: [countF, 2, 1], // Uses actual active count + some mockup data for pending/archived
                            backgroundColor: ['#3b82f6', '#f59e0b', '#6b7280']
                        }]
                    },
                    options: { responsive: true, maintainAspectRatio: false }
                });

                // Announcements & Reports Chart (Bar)
                var rawA = localStorage.getItem('bantay-dagat-announcements');
                var countA = 2;
                if (rawA) {
                    try { countA = JSON.parse(rawA).length; } catch(e) {}
                }

                var rawR = localStorage.getItem('bantay-dagat-feedback');
                var countR = 8;
                if (rawR) {
                    try { countR = JSON.parse(rawR).length; } catch(e) {}
                }

                var ctxA = document.getElementById('activityChart').getContext('2d');
                new Chart(ctxA, {
                    type: 'bar',
                    data: {
                        labels: ['Announcements Sent', 'Incident Reports'],
                        datasets: [{
                            label: 'Total Count',
                            data: [countA, countR],
                            backgroundColor: ['#10b981', '#ef4444']
                        }]
                    },
                    options: { 
                        responsive: true, 
                        maintainAspectRatio: false,
                        plugins: { legend: { display: false } },
                        scales: { y: { beginAtZero: true, ticks: { stepSize: 1 } } }
                    }
                });
            });
        </script>
    }
}
