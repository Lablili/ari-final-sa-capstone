@{
    ViewData["Title"] = "Announcements";
}



<div class="dashboard-shell hidden" id="dashboardShell">
    @await Html.PartialAsync("_DashboardSidebar")

    <main class="main-content">
        <header class="topbar">
            <div class="topbar-title-area">
                <h2>Announcements</h2>
            </div>
            <div class="topbar-meta">
                <span class="stat-badge" id="announcementCount">0 SENT TODAY</span>
                <span class="date-indicator">
                    <svg class="date-icon" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="16" height="16">
                        <rect x="3" y="4" width="18" height="18" rx="2" ry="2"></rect>
                        <path stroke-linecap="round" stroke-linejoin="round" d="M16 2v4M8 2v4M3 10h18"></path>
                    </svg>
                    <span id="currentDateDisplay">Wednesday, May 27, 2026</span>
                </span>

            </div>
        </header>

        <section class="compose-form-panel">
            <div class="compose-header">
                <span>Compose Announcement</span>
            </div>
            <form class="announcement-form-grid" id="announcementForm">
                <div class="form-grid-2col">
                    <div class="form-field-wrapper">
                        <label class="form-label-with-icon" for="announcementTemplate">Category</label>
                        <select class="form-input-styled" id="announcementTemplate" name="template">
                            <option value="ordinance">Ordinance reminder</option>
                            <option value="no-fishing">No-fishing zone notice</option>
                            <option value="patrol">Patrol advisory</option>
                            <option value="custom">Custom announcement</option>
                        </select>
                    </div>
                    <div class="form-field-wrapper">
                        <label class="form-label-with-icon" for="recipientGroup">Recipient Group</label>
                        <select class="form-input-styled" id="recipientGroup" name="recipientGroup">
                            <option value="all">All registered fisherfolk (1,248)</option>
                            <option value="north">Barangay Sulangan (312)</option>
                            <option value="south">Barangay Patao (284)</option>
                            <option value="licensed">Barangay Guiwanon (652)</option>
                        </select>
                    </div>
                    <div class="form-field-wrapper">
                        <label class="form-label-with-icon" for="announcementLocation">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="14" height="14">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M17.657 16.657L13.414 20.9a1.998 1.998 0 01-2.827 0l-4.244-4.243a8 8 0 1111.314 0z"></path>
                                <path stroke-linecap="round" stroke-linejoin="round" d="M15 11a3 3 0 11-6 0 3 3 0 016 0z"></path>
                            </svg>
                            <span>Area / Location</span>
                        </label>
                        <input class="form-input-styled" id="announcementLocation" name="location" type="text">
                    </div>
                    <div class="form-field-wrapper">
                        <label class="form-label-with-icon" for="announcementEffectiveDate">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="14" height="14">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M8 7V3m8 4V3m-9 8h10M5 21h14a2 2 0 002-2V7a2 2 0 00-2-2H5a2 2 0 00-2 2v12a2 2 0 002 2z"></path>
                            </svg>
                            <span>Effective Date</span>
                        </label>
                        <input class="form-input-styled" id="announcementEffectiveDate" name="effectiveDate" type="text">
                    </div>
                    <div class="form-field-wrapper">
                        <label class="form-label-with-icon" for="announcementOfficer">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="14" height="14">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M16 7a4 4 0 11-8 0 4 4 0 018 0zM12 14a7 7 0 00-7 7h14a7 7 0 00-7-7z"></path>
                            </svg>
                            <span>Issued By (Officer)</span>
                        </label>
                        <input class="form-input-styled" id="announcementOfficer" name="officer" type="text">
                    </div>
                    <div class="form-field-wrapper">
                        <label class="form-label-with-icon" for="announcementPenalty">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="14" height="14">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12l2 2 4-4m5.618-4.016A11.955 11.955 0 0112 2.944a11.955 11.955 0 01-8.618 3.04A12.02 12.02 0 003 9c0 5.591 3.824 10.29 9 11.622 5.176-1.332 9-6.03 9-11.622 0-1.042-.133-2.052-.382-3.016z"></path>
                            </svg>
                            <span>Penalty / Consequence (If Applicable)</span>
                        </label>
                        <input class="form-input-styled" id="announcementPenalty" name="penalty" type="text">
                    </div>
                    <div class="form-field-wrapper form-span-full">
                        <label class="form-label-with-icon" for="announcementReference">
                            <svg fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24" xmlns="http://www.w3.org/2000/svg" width="14" height="14">
                                <path stroke-linecap="round" stroke-linejoin="round" d="M9 12h6m-6 4h6m2 5H7a2 2 0 01-2-2V5a2 2 0 012-2h5.586a1 1 0 01.707.293l5.414 5.414a1 1 0 01.293.707V19a2 2 0 01-2 2z"></path>
                            </svg>
                            <span>Reference Ordinance / Resolution No.</span>
                        </label>
                        <input class="form-input-styled" id="announcementReference" name="referenceNo" type="text">
                    </div>
                    <div class="form-field-wrapper form-span-full">
                        <label class="form-label-with-icon" for="announcementDetails">Additional Details</label>
                        <textarea class="form-textarea-styled" id="announcementDetails" name="details"></textarea>
                    </div>
                </div>

                <div class="compose-actions">
                    <div class="action-left-group"></div>
                    <button class="btn-outline" id="clearFormBtn" type="button">Clear</button>
                    <button class="btn-submit-orange" type="submit">Send announcement</button>
                </div>
            </form>
        </section>

        <div class="log-header-section">
            <div class="log-title-area">
                <h3>Announcement log</h3>
                <p class="log-subtitle">Filter, search, or review active broadcasts delivered over the GSM Network.</p>
            </div>
            <div class="log-actions">
                <button class="btn-outline" id="printLogBtn" type="button">Print</button>
                <button class="btn-outline" id="exportLogBtn" type="button">Export CSV</button>
            </div>
        </div>

        <div class="log-tabs-panel" id="logFilterTabs">
            <div class="tabs-main">
                <button class="tab-button active" data-filter="all" type="button">All <span class="tab-count" id="count-all">0</span></button>
                <button class="tab-button" data-filter="ordinance" type="button">Ordinance <span class="tab-count" id="count-ordinance">0</span></button>
                <button class="tab-button" data-filter="no-fishing" type="button">No-fishing <span class="tab-count" id="count-no-fishing">0</span></button>
                <button class="tab-button" data-filter="patrol" type="button">Patrol <span class="tab-count" id="count-patrol">0</span></button>
                <button class="tab-button" data-filter="other" type="button">Other <span class="tab-count" id="count-other">0</span></button>
            </div>
            <div class="tabs-archive">
                <button class="tab-button" data-filter="archived" type="button">Archived <span class="tab-count" id="count-archived">0</span></button>
            </div>
        </div>

        <div class="board-grid" id="announcementBoard">
            <div class="board-column" data-col="ordinance">
                <div class="column-body" id="col-ordinance"></div>
            </div>
            <div class="board-column" data-col="no-fishing">
                <div class="column-body" id="col-no-fishing"></div>
            </div>
            <div class="board-column" data-col="other">
                <div class="column-body" id="col-other"></div>
            </div>
        </div>
        <div style="display:none;" id="announcementLog"></div>
    </main>
</div>

@section Scripts {
    <script src="~/js/announcement.js" asp-append-version="true"></script>
}
