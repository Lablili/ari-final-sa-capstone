@model ari_final_sa_capstone.Models.ForgotPasswordViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html>
<head>
    <meta charset="utf-8" />
    <title>Forgot Password - Fisheries Monitoring System</title>
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        body { margin: 0; font-family: 'Segoe UI', sans-serif; }
        .split-container { display: flex; min-height: 100vh; }
        .left-panel { flex: 1; background: linear-gradient(135deg, #1e3a8a, #2563eb); color: white; padding: 60px 50px; display: flex; flex-direction: column; justify-content: space-between; }
        .left-panel .logo-icon { font-size: 40px; margin-bottom: 40px; }
        .left-panel h1 { font-size: 42px; font-weight: 800; line-height: 1.2; }
        .left-panel p { font-size: 15px; opacity: 0.9; margin-top: 20px; max-width: 380px; }
        .left-panel .footer-text { font-size: 13px; opacity: 0.7; }
        .right-panel { flex: 1; display: flex; align-items: center; justify-content: center; padding: 40px; }
        .login-box { width: 100%; max-width: 380px; }
        .login-box h2 { font-weight: 800; font-size: 28px; margin-bottom: 8px; }
        .login-box .subtitle { color: #6b7280; font-size: 14px; margin-bottom: 30px; }
        .form-control { border: none; border-bottom: 1px solid #d1d5db; border-radius: 0; padding-left: 0; }
        .form-control:focus { box-shadow: none; border-bottom: 1px solid #2563eb; }
        .btn-login { background: #111827; color: white; border-radius: 8px; padding: 12px; font-weight: 600; width: 100%; margin-top: 20px; }
        .btn-login:hover { background: #1f2937; }
        .forgot-link { margin-top: 20px; text-align: center; font-size: 13px; }
    </style>
</head>
<body>
    <div class="split-container">
        <div class="left-panel">
            <div>
                <div class="logo-icon">🐟</div>
                <h1>Forgot<br />Password</h1>
                <p>Don't worry, we'll help you get back into your account securely.</p>
            </div>
            <div class="footer-text">© 2026 Fisheries Monitoring System. All rights reserved.</div>
        </div>

        <div class="right-panel">
            <div class="login-box">
                <h2>Reset Password</h2>
                <p class="subtitle">Enter your email address to receive a reset link.</p>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    <div class="mb-4">
                        <input asp-for="Email" class="form-control" placeholder="Email address" />
                        <span asp-validation-for="Email" class="text-danger small"></span>
                    </div>

                    <button type="submit" class="btn btn-login">Send Reset Link</button>
                </form>

                <div class="forgot-link">
                    Remembered it? <a href="@Url.Action("Login", "Account")" class="fw-bold text-dark">Back to Login</a>
                </div>
            </div>
        </div>
    </div>
</body>
</html>
