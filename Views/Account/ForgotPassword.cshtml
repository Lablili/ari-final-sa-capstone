@model ari_final_sa_capstone.Models.ForgotPasswordViewModel
@{
    Layout = null;
}

<!DOCTYPE html>
<html lang="en">
<head>
    <meta charset="utf-8" />
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <title>Reset Password &middot; Bantay Dagat Maritime Portal</title>
    <link rel="preconnect" href="https://fonts.googleapis.com">
    <link rel="preconnect" href="https://fonts.gstatic.com" crossorigin>
    <link href="https://fonts.googleapis.com/css2?family=Inter:wght@400;500;600;700&display=swap" rel="stylesheet">
    <link href="~/lib/bootstrap/dist/css/bootstrap.min.css" rel="stylesheet" />
    <style>
        :root {
            --primary-navy: #153966;
            --primary-navy-dark: #0f2747;
            --primary-blue: #1c5496;
            --primary-blue-hover: #133e70;
            --text-main: #1e293b;
            --text-secondary: #475569;
            --text-muted: #64748b;
            --input-border: #cbd5e1;
            --input-focus-border: #1c5496;
            --input-bg: #ffffff;
            --card-border: #e2e8f0;
            --page-bg: #f1f5f9;
        }

        * { box-sizing: border-box; }

        body {
            margin: 0;
            padding: 0;
            font-family: 'Inter', -apple-system, BlinkMacSystemFont, "Segoe UI", Roboto, sans-serif;
            background-color: var(--page-bg);
            color: var(--text-main);
            min-height: 100vh;
            -webkit-font-smoothing: antialiased;
        }

        .split-container {
            display: flex;
            min-height: 100vh;
            width: 100%;
        }

        .left-panel {
            flex: 1.1;
            background: linear-gradient(180deg, rgba(15, 39, 71, 0.82) 0%, rgba(10, 25, 47, 0.90) 100%), url('/bantayan-townhall.jpg') center/cover no-repeat;
            color: #ffffff;
            padding: 56px 64px;
            display: flex;
            flex-direction: column;
            justify-content: space-between;
            border-right: 1px solid rgba(255, 255, 255, 0.08);
        }

        .left-panel-content { position: relative; z-index: 2; }

        .brand-badges {
            display: flex;
            align-items: center;
            gap: 14px;
            margin-bottom: 28px;
        }

        .brand-seal-img {
            width: 56px;
            height: 56px;
            border-radius: 50%;
            object-fit: cover;
            background: #ffffff;
            padding: 2px;
            border: 2px solid #ffffff;
        }

        .brand-meta-tag {
            font-size: 0.75rem;
            letter-spacing: 0.06em;
            text-transform: uppercase;
            font-weight: 600;
            color: #dbeafe;
            background-color: rgba(255, 255, 255, 0.12);
            padding: 4px 10px;
            border-radius: 4px;
            display: inline-block;
        }

        .left-panel h1 {
            font-size: 2.35rem;
            font-weight: 700;
            line-height: 1.2;
            letter-spacing: -0.01em;
            margin: 16px 0 12px 0;
            color: #ffffff;
        }

        .left-panel .lead-text {
            font-size: 0.98rem;
            line-height: 1.6;
            color: #cbd5e1;
            max-width: 440px;
        }

        .left-footer {
            padding-top: 24px;
            border-top: 1px solid rgba(255, 255, 255, 0.15);
            font-size: 0.8rem;
            color: #94a3b8;
        }

        .right-panel {
            flex: 1;
            display: flex;
            flex-direction: column;
            align-items: center;
            justify-content: center;
            padding: 48px 36px;
            background-color: #ffffff;
        }

        .login-card {
            width: 100%;
            max-width: 390px;
        }

        .mobile-brand-banner {
            display: none;
            text-align: center;
            margin-bottom: 24px;
        }

        .mobile-brand-banner img {
            width: 52px;
            height: 52px;
            border-radius: 50%;
            margin: 0 4px;
            border: 1px solid var(--card-border);
        }

        .login-header {
            margin-bottom: 28px;
        }

        .login-header h2 {
            font-size: 1.7rem;
            font-weight: 700;
            color: var(--text-main);
            margin: 0 0 8px 0;
            letter-spacing: -0.01em;
        }

        .login-header .subtitle {
            font-size: 0.9rem;
            color: var(--text-secondary);
            margin: 0;
            line-height: 1.5;
        }

        .form-group {
            margin-bottom: 20px;
        }

        .form-label {
            display: block;
            font-size: 0.84rem;
            font-weight: 600;
            color: #334155;
            margin-bottom: 6px;
        }

        .input-wrapper {
            position: relative;
            display: flex;
            align-items: center;
        }

        .input-icon {
            position: absolute;
            left: 14px;
            color: #64748b;
            pointer-events: none;
        }

        .custom-input {
            width: 100%;
            height: 46px;
            padding: 10px 14px 10px 42px;
            font-size: 0.94rem;
            font-family: inherit;
            color: var(--text-main);
            background-color: var(--input-bg);
            border: 1.5px solid var(--input-border);
            border-radius: 8px;
            transition: border-color 0.15s ease;
        }

        .custom-input:focus {
            border-color: var(--input-focus-border);
            box-shadow: 0 0 0 3px rgba(28, 84, 150, 0.12);
            outline: none;
        }

        .btn-submit {
            width: 100%;
            height: 46px;
            background-color: var(--primary-blue);
            color: #ffffff;
            border: none;
            border-radius: 8px;
            font-size: 0.95rem;
            font-weight: 600;
            cursor: pointer;
            transition: background-color 0.15s ease;
            margin-top: 20px;
        }

        .btn-submit:hover {
            background-color: var(--primary-blue-hover);
        }

        .back-link {
            display: block;
            text-align: center;
            margin-top: 20px;
            font-size: 0.86rem;
            color: var(--text-muted);
        }

        .back-link a {
            color: var(--primary-blue);
            text-decoration: none;
            font-weight: 600;
        }

        .back-link a:hover {
            text-decoration: underline;
        }

        @@media (max-width: 768px) {
            .left-panel { display: none; }
            .mobile-brand-banner { display: block; }
            .right-panel {
                padding: 40px 20px;
                min-height: 100vh;
                background-color: var(--page-bg);
            }
            .login-card {
                background-color: #ffffff;
                padding: 32px 24px;
                border-radius: 12px;
                border: 1px solid var(--card-border);
                box-shadow: 0 4px 6px -1px rgba(0, 0, 0, 0.05);
            }
            .login-header { text-align: center; }
        }
    </style>
</head>
<body>
    <div class="split-container">
        <aside class="left-panel">
            <div class="left-panel-content">
                <div class="brand-badges">
                    <img src="~/logo-bantayan.jpg" alt="Municipality of Bantayan Seal" class="brand-seal-img" />
                    <img src="~/logo-bantaydagat.jpg" alt="Bantay Dagat Emblem" class="brand-seal-img" />
                    <span class="brand-meta-tag">Account Security</span>
                </div>

                <h1>Account<br />Recovery</h1>
                <p class="lead-text">
                    Enter your registered personnel email address and we'll dispatch a secure password reset link to regain access to the portal.
                </p>
            </div>

            <div class="left-footer">
                &copy; @DateTime.Now.Year Municipality of Bantayan, Cebu &middot; Fisheries Monitoring System
            </div>
        </aside>

        <main class="right-panel">
            <div class="login-card">
                <div class="mobile-brand-banner">
                    <img src="~/logo-bantayan.jpg" alt="Municipality of Bantayan Seal" />
                    <img src="~/logo-bantaydagat.jpg" alt="Bantay Dagat Emblem" />
                </div>

                <div class="login-header">
                    <h2>Reset Password</h2>
                    <p class="subtitle">Please provide your authorized account email below.</p>
                </div>

                @if (!ViewData.ModelState.IsValid)
                {
                    <div class="alert alert-danger py-2 small mb-3">
                        <div asp-validation-summary="All"></div>
                    </div>
                }

                <form asp-controller="Account" asp-action="ForgotPassword" method="post">
                    @Html.AntiForgeryToken()

                    <div class="form-group">
                        <label asp-for="Email" class="form-label">Email Address</label>
                        <div class="input-wrapper">
                            <span class="input-icon">
                                <svg width="17" height="17" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2" stroke-linecap="round" stroke-linejoin="round">
                                    <path d="M4 4h16c1.1 0 2 .9 2 2v12c0 1.1-.9 2-2 2H4c-1.1 0-2-.9-2-2V6c0-1.1.9-2 2-2z"></path>
                                    <polyline points="22,6 12,13 2,6"></polyline>
                                </svg>
                            </span>
                            <input asp-for="Email" class="custom-input" placeholder="e.g. officer@bantayan.gov.ph" autofocus required />
                        </div>
                        <span asp-validation-for="Email" class="text-danger small mt-1 d-block"></span>
                    </div>

                    <button type="submit" class="btn-submit">Send Reset Link</button>
                </form>

                <div class="back-link">
                    Remembered your password? <a href="@Url.Action("Login", "Account")">Back to Sign In</a>
                </div>
            </div>
        </main>
    </div>
</body>
</html>