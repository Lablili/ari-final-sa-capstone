@{
    var controller = ViewContext.RouteData.Values["controller"]?.ToString() ?? string.Empty;
    var action = ViewContext.RouteData.Values["action"]?.ToString() ?? string.Empty;
    var activePage = (ViewData["ActivePage"] as string) ?? string.Empty;
    
    if (string.IsNullOrEmpty(activePage))
    {
        if (controller.Equals("UserManagement", StringComparison.OrdinalIgnoreCase))
        {
            activePage = "UserManagement";
        }
        else if (controller.Equals("BlotterReport", StringComparison.OrdinalIgnoreCase))
        {
            activePage = "Feedback";
        }
        else
        {
            activePage = action;
        }
    }
    
    Func<string, string> navClass = page => activePage.Equals(page, StringComparison.OrdinalIgnoreCase) ? "nav-item active" : "nav-item";

    var sessionUser = Context?.Session?.GetString("UserName");
    var sessionRole = Context?.Session?.GetString("UserRole");
    var displayName = !string.IsNullOrEmpty(sessionUser) ? sessionUser : (User?.Identity?.Name ?? "");
    var displayRole = !string.IsNullOrEmpty(sessionRole) ? sessionRole : (User != null && User.Identity.IsAuthenticated ? string.Join(", ", (User.Claims.Where(c => c.Type == System.Security.Claims.ClaimTypes.Role).Select(c => c.Value))) : "");
}

<!-- Mobile Nav Header Bar (Visible ONLY on Mobile & Tablet <= 1024px) -->
<div class="mobile-nav-header" id="mobileNavHeader">
    <button type="button" class="btn-mobile-menu-toggle" id="btnMobileMenuToggle" onclick="toggleMobileSidebar()" aria-label="Toggle navigation menu">
        <svg width="22" height="22" viewBox="0 0 24 24" fill="none" stroke="currentColor" stroke-width="2.2" stroke-linecap="round" stroke-linejoin="round">
            <line x1="3" y1="12" x2="21" y2="12"></line>
            <line x1="3" y1="6" x2="21" y2="6"></line>
            <line x1="3" y1="18" x2="21" y2="18"></line>
        </svg>
    </button>
    <div class="mobile-brand-title">
        <span class="mobile-brand-name">Bantay Dagat</span>
    </div>
    <div class="mobile-header-user">
        <span class="mobile-user-avatar" title="@displayName">👤</span>
    </div>
</div>

<!-- Backdrop Overlay for Mobile/Tablet Off-canvas Sidebar -->
<div class="mobile-sidebar-backdrop" id="mobileSidebarBackdrop" onclick="closeMobileSidebar()"></div>

<aside class="sidebar" id="appSidebar">
    <div class="brand">
        <div style="display: flex; align-items: center; justify-content: space-between; width: 100%;">
            <h1>Bantay Dagat</h1>
            <button type="button" class="sidebar-mobile-close" onclick="closeMobileSidebar()" aria-label="Close menu">&times;</button>
        </div>
    </div>

    <div class="nav-group">
        <p class="nav-label">MAIN</p>
        <nav class="nav-menu">
            @if (displayRole == "FisheriesAdmin" || displayRole == "BantayDagatAdmin")
            {
                <a class="@navClass("Index")" asp-controller="Home" asp-action="Index">
                    <span class="nav-icon overview-icon" aria-hidden="true"></span>
                    <span>Overview</span>
                </a>
            }
            @if (displayRole == "SuperAdmin")
            {
                <a class="@navClass("SystemDashboard")" asp-controller="SuperAdmin" asp-action="SystemDashboard">
                    <span class="nav-icon overview-icon" aria-hidden="true"></span>
                    <span>System Dashboard</span>
                </a>
            }
            
            @if (displayRole == "BantayDagatAdmin")
            {
                <a class="@navClass("Feedback")" asp-controller="Home" asp-action="Feedback">
                    <span class="nav-icon report-icon" aria-hidden="true"></span>
                    <span>Community Reports</span>
                </a>
            }
            @if (displayRole == "FisheriesAdmin" || displayRole == "BantayDagatAdmin")
            {
                <a class="@navClass("FisherfolkInfo")" asp-controller="Home" asp-action="FisherfolkInfo">
                    <span class="nav-icon fisherfolk-icon" aria-hidden="true"></span>
                    <span>Fisherfolk Info</span>
                </a>
            }
            
        </nav>
    </div>

    @if (displayRole == "SuperAdmin" || displayRole == "FisheriesAdmin" || displayRole == "BantayDagatAdmin")
    {
        <div class="nav-group">
            <p class="nav-label">COORDINATION</p>
            <nav class="nav-menu">
                <a href="javascript:void(0)" class="nav-item" onclick="if(window.toggleAdminChat) { window.toggleAdminChat(); } else { alert('Admin Chat is not available for your session.'); }">
                    <span class="nav-icon" aria-hidden="true">💬</span>
                    <span>Admin Comms</span>
                </a>
            </nav>
        </div>
    }

    @if (displayRole == "FisheriesAdmin" || displayRole == "BantayDagatAdmin")
    {
        <div class="nav-group">
            <p class="nav-label">COMMUNICATION</p>
            <nav class="nav-menu">
                <a class="@navClass("Announcement")" asp-controller="Home" asp-action="Announcement">
                    <span class="nav-icon announcement-icon" aria-hidden="true"></span>
                    <span>Announcements</span>
                </a>
                <a class="@navClass("SMSOperations")" asp-controller="Home" asp-action="SMSOperations">
                    <span class="nav-icon report-icon" aria-hidden="true"></span>
                    <span>SMS Operations</span>
                </a>
            </nav>
        </div>
    }

    @if (displayRole == "SuperAdmin")
    {
        <div class="nav-group">
            <p class="nav-label">ADMINISTRATION (SUPER ADMIN)</p>
            <nav class="nav-menu">
                <a class="@navClass("UserManagement")" asp-controller="UserManagement" asp-action="Index">
                    <span class="nav-icon admin-icon" aria-hidden="true"></span>
                    <span>User Management</span>
                </a>
                <a class="@navClass("Monitoring")" asp-controller="SuperAdmin" asp-action="Monitoring">
                    <span class="nav-icon report-icon" aria-hidden="true"></span>
                    <span>Health & Settings</span>
                </a>
                <a class="@navClass("DataExport")" asp-controller="SuperAdmin" asp-action="DataExport">
                    <span class="nav-icon announcement-icon" aria-hidden="true"></span>
                    <span>Data Export Center</span>
                </a>
            </nav>
        </div>
    }


    <div class="nav-group">
        <p class="nav-label">ACCOUNT</p>
        <nav class="nav-menu">
            <form asp-controller="Account" asp-action="Logout" method="post" class="logout-form" style="margin: 0;">
                @Html.AntiForgeryToken()
                <button type="submit" class="nav-item btn-logout-link" style="background: none; border: none; width: 100%; text-align: left; cursor: pointer; display: flex; align-items: center; gap: 12px; padding: 10px 14px; color: #94a3b8; font-size: 0.9rem; font-weight: 500; border-radius: 8px; transition: all 0.2s;">
                    <span class="nav-icon logout-icon" aria-hidden="true"></span>
                    <span>Logout</span>
                </button>
            </form>
        </nav>
    </div>

    @if (!string.IsNullOrEmpty(displayName))
    {
        <div class="sidebar-profile-simple" style="display: flex; align-items: center; gap: 12px; padding: 16px 14px; border-top: 1px solid #1e293b; margin-top: auto;">
            <div style="font-size: 1.3rem; display: flex; align-items: center; justify-content: center; width: 32px; height: 32px; background-color: rgba(255,255,255,0.08); border-radius: 50%; color: #ffffff;">👤</div>
            <span style="font-size: 0.9rem; font-weight: 600; color: #ffffff; text-overflow: ellipsis; white-space: nowrap; overflow: hidden;" title="@displayName">@displayName</span>
        </div>
    }
</aside>

<script>
    function toggleMobileSidebar() {
        var sidebar = document.getElementById('appSidebar');
        var backdrop = document.getElementById('mobileSidebarBackdrop');
        if (sidebar) {
            sidebar.classList.toggle('mobile-open');
        }
        if (backdrop) {
            backdrop.classList.toggle('active');
        }
    }

    function closeMobileSidebar() {
        var sidebar = document.getElementById('appSidebar');
        var backdrop = document.getElementById('mobileSidebarBackdrop');
        if (sidebar) {
            sidebar.classList.remove('mobile-open');
        }
        if (backdrop) {
            backdrop.classList.remove('active');
        }
    }

    // Auto-close drawer when clicking any link if on mobile/tablet
    document.addEventListener('DOMContentLoaded', function () {
        var sidebar = document.getElementById('appSidebar');
        if (sidebar) {
            var navLinks = sidebar.querySelectorAll('.nav-item');
            navLinks.forEach(function (link) {
                link.addEventListener('click', function () {
                    if (window.innerWidth <= 1024) {
                        setTimeout(closeMobileSidebar, 150);
                    }
                });
            });
        }
    });
</script>
