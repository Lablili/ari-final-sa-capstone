@{
    ViewData["Title"] = "Manual Survey Entry";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["ActivePage"] = "AnalyticsDashboard";
}

<div class="content-header mb-4">
    <h2>Manual Survey Entry (MVP)</h2>
    <p class="text-muted">Enter manual feedback or interview results for evaluation.</p>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="SubmitSurvey" method="post">
            <div class="mb-3">
                <label for="Question" class="form-label">Survey Question / Metric Evaluated</label>
                <input type="text" class="form-control" id="Question" name="Question" placeholder="e.g. Do you feel safer using the SMS system?" required />
            </div>
            
            <div class="mb-3">
                <label for="ResultData" class="form-label">Results Data summary</label>
                <textarea class="form-control" id="ResultData" name="ResultData" rows="4" placeholder="e.g. 85% answered Yes, 15% answered No." required></textarea>
            </div>
            
            <div class="mt-4">
                <button type="submit" class="btn btn-primary px-4">Save Survey Data</button>
                <a asp-action="Dashboard" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>
