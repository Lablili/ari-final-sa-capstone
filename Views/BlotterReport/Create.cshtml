@model ari_final_sa_capstone.Models.BlotterReport
@{
    ViewData["Title"] = "Create Blotter Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["ActivePage"] = "BlotterReports";
}

<div class="dashboard-shell">
    @await Html.PartialAsync("_DashboardSidebar")
    <main class="main-content" style="padding: 20px;">

<div class="content-header mb-4">
    <h2>Create Blotter Report</h2>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Create">
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="IncidentType" class="form-label">Type of Incident</label>
                    <select asp-for="IncidentType" class="form-select" required>
                        <option value="">Select...</option>
                        <option value="Illegal Fishing">Illegal Fishing (Dynamite, Cyanide, etc.)</option>
                        <option value="Encroachment">Encroaching Vessel</option>
                        <option value="Distress">Vessel in Distress / SOS</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="IncidentDate" class="form-label">Date & Time</label>
                    <input asp-for="IncidentDate" class="form-control" required />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Location" class="form-label">Location (Barangay/Coordinates)</label>
                    <input asp-for="Location" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ReportSource" class="form-label">Report Source</label>
                    <select asp-for="ReportSource" class="form-select" required>
                        <option value="">Select...</option>
                        <option value="SMS Report">SMS Report</option>
                        <option value="Direct Observation">Direct Observation / Patrol</option>
                        <option value="Walk-in">Walk-in</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ActionsTaken" class="form-label">Actions Taken (Response)</label>
                <textarea asp-for="ActionsTaken" class="form-control" rows="3" required></textarea>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="ResponseTimeMinutes" class="form-label">Response Time (Minutes)</label>
                    <input asp-for="ResponseTimeMinutes" type="number" step="0.1" class="form-control" value="0" />
                    <small class="text-muted">Time from report received to dispatch/action.</small>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Outcome" class="form-label">Outcome</label>
                    <input asp-for="Outcome" class="form-control" value="Pending" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Status" class="form-label">Case Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Open">Open</option>
                        <option value="Closed">Closed</option>
                        <option value="Dismissed">Dismissed</option>
                    </select>
                </div>
            </div>

            <div class="mt-4">
                <button type="submit" class="btn btn-primary px-4">Save Report</button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>

    </main>
</div>

@section Scripts {
    <script>
        document.addEventListener('DOMContentLoaded', function() {
            const form = document.querySelector('form');
            const draftKey = 'blotter_create_draft';
            
            // Load draft
            const savedDraft = localStorage.getItem(draftKey);
            if (savedDraft) {
                const data = JSON.parse(savedDraft);
                for (const key in data) {
                    const input = form.elements[key];
                    if (input && input.type !== 'submit' && input.type !== 'button') {
                        input.value = data[key];
                    }
                }
                console.log('Draft loaded from localStorage.');
            }

            // Auto-save on input
            form.addEventListener('input', function() {
                const data = {};
                for (let i = 0; i < form.elements.length; i++) {
                    const input = form.elements[i];
                    if (input.name && input.type !== 'submit' && input.type !== 'button' && input.type !== 'hidden') {
                        data[input.name] = input.value;
                    }
                }
                localStorage.setItem(draftKey, JSON.stringify(data));
            });

            // Clear draft on submit
            form.addEventListener('submit', function() {
                localStorage.removeItem(draftKey);
            });
        });
    </script>
}
