@model IEnumerable<ari_final_sa_capstone.Models.BlotterReport>
@{
    ViewData["Title"] = "Blotter Reports";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["ActivePage"] = "BlotterReports";
}

<div class="dashboard-shell">
    @await Html.PartialAsync("_DashboardSidebar")
    <main class="main-content" style="padding: 20px;">

<div class="content-header">
    <div class="d-flex justify-content-between align-items-center mb-4">
        <h2>Blotter Reports</h2>
        <a asp-action="Create" class="btn btn-primary">Create New Report</a>
    </div>
</div>

<div class="table-responsive">
    <table class="table table-striped table-hover">
        <thead>
            <tr>
                <th>ID</th>
                <th>Date</th>
                <th>Type</th>
                <th>Location</th>
                <th>Status</th>
                <th>Actions</th>
            </tr>
        </thead>
        <tbody>
            @foreach (var item in Model) {
                <tr>
                    <td>@item.IncidentId</td>
                    <td>@item.IncidentDate.ToString("yyyy-MM-dd HH:mm")</td>
                    <td>@item.IncidentType</td>
                    <td>@item.Location</td>
                    <td>
                        <span class="badge @(item.Status == "Open" ? "bg-warning text-dark" : "bg-success")">
                            @item.Status
                        </span>
                    </td>
                    <td>
                        <a asp-action="Edit" asp-route-id="@item.IncidentId" class="btn btn-sm btn-outline-secondary">Edit</a>
                    </td>
                </tr>
            }
        </tbody>
    </table>
</div>

    </main>
</div>
