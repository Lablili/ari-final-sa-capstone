@model ari_final_sa_capstone.Models.BlotterReport
@{
    ViewData["Title"] = "Edit Blotter Report";
    Layout = "~/Views/Shared/_Layout.cshtml";
    ViewData["ActivePage"] = "BlotterReports";
}

<div class="dashboard-shell">
    @await Html.PartialAsync("_DashboardSidebar")
    <main class="main-content" style="padding: 20px;">

<div class="content-header" style="margin-bottom: 24px; display: flex; align-items: center; gap: 14px; padding: 6px 0 16px 0;">
    <a asp-action="Index" 
       title="Back to Blotter Reports" 
       aria-label="Back to Blotter Reports"
       style="display: inline-flex; align-items: center; justify-content: center; width: 42px; height: 42px; border-radius: 8px; background: #ffffff; border: 1.5px solid #cbd5e1; color: #475569; text-decoration: none; cursor: pointer; transition: all 0.2s ease; box-shadow: 0 1px 2px rgba(0,0,0,0.05);"
       onmouseover="this.style.background='#f1f5f9'; this.style.borderColor='#94a3b8'; this.style.color='#1e293b';"
       onmouseout="this.style.background='#ffffff'; this.style.borderColor='#cbd5e1'; this.style.color='#475569';">
        <svg width="20" height="20" fill="none" stroke="currentColor" stroke-width="2.5" viewBox="0 0 24 24">
            <line x1="19" y1="12" x2="5" y2="12"></line>
            <polyline points="12 19 5 12 12 5"></polyline>
        </svg>
    </a>
    <div>
        <h2 style="font-weight: 700; margin: 0; font-size: 1.65rem; color: #1e293b;">Edit Blotter Report</h2>
        <p style="margin: 3px 0 0; font-size: 0.9rem; color: #64748b;">Update details or apprehension records for Incident #@Model.IncidentId.ToString("D2")</p>
    </div>
</div>

<div class="card shadow-sm">
    <div class="card-body">
        <form asp-action="Edit">
            <input type="hidden" asp-for="IncidentId" />
            <input type="hidden" asp-for="RelatedReportSubmissionId" />
            
            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="IncidentType" class="form-label">Type of Incident</label>
                    <select asp-for="IncidentType" class="form-select" required>
                        <option value="">Select...</option>
                        <option value="Illegal Fishing">Illegal Fishing (Dynamite, Cyanide, etc.)</option>
                        <option value="Encroachment">Encroaching Vessel</option>
                        <option value="Distress">Vessel in Distress / SOS</option>
                        <option value="Other">Other</option>
                    </select>
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="IncidentDate" class="form-label">Date & Time</label>
                    <input asp-for="IncidentDate" class="form-control" required />
                </div>
            </div>

            <div class="row">
                <div class="col-md-6 mb-3">
                    <label asp-for="Location" class="form-label">Location (Barangay/Coordinates)</label>
                    <input asp-for="Location" class="form-control" required />
                </div>
                <div class="col-md-6 mb-3">
                    <label asp-for="ReportSource" class="form-label">Report Source</label>
                    <select asp-for="ReportSource" class="form-select" required>
                        <option value="">Select...</option>
                        <option value="SMS Report">SMS Report</option>
                        <option value="Direct Observation">Direct Observation / Patrol</option>
                        <option value="Walk-in">Walk-in</option>
                    </select>
                </div>
            </div>

            <div class="mb-3">
                <label asp-for="ActionsTaken" class="form-label">Actions Taken (Response)</label>
                <textarea asp-for="ActionsTaken" class="form-control" rows="3" required></textarea>
            </div>

            <div class="row">
                <div class="col-md-4 mb-3">
                    <label asp-for="ResponseTimeMinutes" class="form-label">Response Time (Minutes)</label>
                    <input asp-for="ResponseTimeMinutes" type="number" step="0.1" class="form-control" value="@Model.ResponseTimeMinutes" />
                    <small class="text-muted">Time from report received to dispatch/action.</small>
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Outcome" class="form-label">Outcome</label>
                    <input asp-for="Outcome" class="form-control" value="@Model.Outcome" />
                </div>
                <div class="col-md-4 mb-3">
                    <label asp-for="Status" class="form-label">Case Status</label>
                    <select asp-for="Status" class="form-select">
                        <option value="Open">Open</option>
                        <option value="Done">Done</option>
                        <option value="Closed">Closed</option>
                        <option value="Dismissed">Dismissed</option>
                    </select>
                </div>
            </div>

            <div class="mt-4" style="display: flex; align-items: center; gap: 8px;">
                <button type="submit" class="btn btn-primary px-4">Save Changes</button>
                <button type="submit" name="markAsDone" value="true" class="btn px-4" style="background: #16a34a; border-color: #16a34a; color: #ffffff; font-weight: 600;">
                    ✓ Save &amp; Mark as Done
                </button>
                <a asp-action="Index" class="btn btn-secondary ms-2">Cancel</a>
            </div>
        </form>
    </div>
</div>

    </main>
</div>
